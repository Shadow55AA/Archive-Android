package com.losoft.ratican.game.obj;

import android.util.Log;

import com.losoft.ratican.engine.GameRenderer;

public class GOPBullet extends GameObject
{
	protected boolean bdead = false;
	protected float vel[] = {0,0,0};
	
	public GOPBullet()
	{
		vel[0]=4;
	}
	
	@Override
	public void step(float dt)
	{
		pos[0]+=vel[0]*dt;
		pos[1]+=vel[1]*dt;
		if(pos[0]>10f)
			this.bdead = true;
	}
	
	public boolean isDead()
	{
		return bdead;
	}
	
	public void kill()
	{
		bdead = true;
	}
	
	@Override
	public void Render(GameRenderer irenderer)
	{
		float size[] = {.25f,.25f,.25f};
		irenderer.setDrawPos(pos);
		irenderer.drawRect(size);
	}
}
