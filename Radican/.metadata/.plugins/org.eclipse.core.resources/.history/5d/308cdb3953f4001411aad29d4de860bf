package com.losoft.ratican.game;

import java.util.ArrayList;
import java.util.Iterator;
import java.util.Random;

import com.losoft.ratican.engine.GameEngine;
import com.losoft.ratican.engine.GameRenderer;
import com.losoft.ratican.game.obj.GOEnemy;
import com.losoft.ratican.game.spawnpattern.SPFlyAssault;
import com.losoft.ratican.game.spawnpattern.SpawnPattern;

public class GameWorld
{
	private ArrayList<GOEnemy> enemies;
	
	private Random rand;
	private int nspawnpatterns,curspawnpattern;
	private ArrayList<SpawnPattern> spawnpatterns;
	private boolean bworldspawned;
	private GameEngine gengine;
	
	public GameWorld(GameEngine igengine)
	{
		gengine = igengine;
		enemies = new ArrayList<GOEnemy>(100);
		rand = new Random();
		spawnpatterns = new ArrayList<SpawnPattern>(20);
	}
	
	public void generate(long iseed)
	{
		rand.setSeed(iseed);
		spawnpatterns.clear();
		nspawnpatterns=10;
		for(int i=0;i<10;i++)
		{
			spawnpatterns.add(i, new SPFlyAssault(gengine));
		}
		curspawnpattern=0;
		bworldspawned = false;
	}
	
	public void step(float dt)
	{
		// Enemies step
		Iterator<GOEnemy> itt = enemies.iterator();
		while(itt.hasNext())
		{
			GOEnemy enemy = itt.next();
			enemy.step(dt);
			if(enemy.isDead())
				itt.remove();
		}
		
		// Spawn
		if(!bworldspawned)
		{
			SpawnPattern sp = spawnpatterns.get(curspawnpattern);
			if(sp!=null)
			{
				sp.spawnStep(dt);
				if(sp.isDead())
				{
					curspawnpattern++;
					if(curspawnpattern>=nspawnpatterns)
					{
						bworldspawned = true;
					}
				}
			}
		}
	}
	
	public void Render(GameRenderer irenderer)
	{
		
	}
	
	public void spawnEnemy(GOEnemy ienemy)
	{
		enemies.add(ienemy);
	}
}