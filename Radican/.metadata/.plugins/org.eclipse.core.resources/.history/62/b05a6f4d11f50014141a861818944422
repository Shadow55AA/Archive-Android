package com.losoft.ratican.game.obj;

import com.losoft.ratican.engine.GameEngine;

public class GOEnemy extends GameObject
{
	protected float pos[] = {0,0,0};
	protected float vel[] = {0,0,0};
	protected boolean bdead;
	protected GameEngine gengine;
	
	public GOEnemy(GameEngine igengine)
	{
		gengine = igengine;
		bdead = false;
	}
	
	public void setPos(float ix,float iy,float iz)
	{
		pos[0] = ix;
		pos[1] = iy;
		pos[2] = iz;
	}
	
	public boolean isDead()
	{
		return bdead;
	}
}
