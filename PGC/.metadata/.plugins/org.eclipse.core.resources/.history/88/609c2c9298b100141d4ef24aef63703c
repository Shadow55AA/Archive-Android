	@Override
	public void run()
	{
		while(brunning)
		{
			if(bdrawgraph&&gfuncs.getGraphMode()==2)
			{
				glview.animatePlot();
				glview.requestRender();
			}
			try
			{ Thread.sleep(50); }
			catch( InterruptedException e)
			{ }
		}
	}

	@Override
	public boolean onTouch(View v, MotionEvent me)
	{
		if(me.getActionMasked()==MotionEvent.ACTION_UP)
		{
			glview.onTouchUp(me.getX(), me.getY());
			//v.performClick();
			long timeup = System.currentTimeMillis();
			if(timeup-timetouchdown<100)
			{
	    		View tview = findViewById(R.id.mainscrollview);
	    		tview.setVisibility(View.VISIBLE);
				v.performClick();
			}
		}
		if(me.getActionMasked()==MotionEvent.ACTION_DOWN)
		{
			glview.onTouchDown(me.getX(), me.getY());
			timetouchdown = System.currentTimeMillis();
		}
		if(me.getActionMasked()==MotionEvent.ACTION_MOVE)
		{
			glview.onTouchMove(me.getX(), me.getY());
		}
		return true;
	}
	
