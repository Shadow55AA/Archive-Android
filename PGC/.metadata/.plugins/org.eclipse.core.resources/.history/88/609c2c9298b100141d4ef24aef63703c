    public void funcListCBoxOnClick(View view)
    {
    	CheckBox tview = (CheckBox)view;
    	CharSequence fname = tview.getText();
    	EqFunction func = calc.GetFunction(fname);
    	if(func!=null)
    	{
    		if(tview.isChecked())
    		{
    			int gfind = gfuncs.addFunction(func);
    			if(gfind>=0)
    			{
    				int fcolor = gfuncs.getColor(gfind);
    				tview.setTextColor(fcolor);
    			}
    			else
    				tview.setChecked(false);
    		}
    		else
    		{
    			gfuncs.removeFunction(func);
    			tview.setTextColor(Color.parseColor("#ff000000"));
    		}
    	}
    	glview.generatePlot();
    	updateGraphIntervalTable();
    	glview.requestRender();
    	//tview.setTextColor(getResources().getColor(R.color.col_red));
    	
    }
    
    public void scrollViewOnClick(View view)
