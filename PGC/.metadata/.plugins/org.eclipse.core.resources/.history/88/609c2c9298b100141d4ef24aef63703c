    class GLSView extends GLSurfaceView
    {
    	private GLRenderer renderer;
		public GLSView(Context context,EqCalculator icalc,GraphedFuncs igfuncs)
		{
			super(context);
			setEGLContextClientVersion(2);
			renderer = new GLRenderer(context,icalc,igfuncs);
			setRenderer(renderer);
			setRenderMode(GLSurfaceView.RENDERMODE_WHEN_DIRTY);
		}
    	
		public void setDrawGraph(boolean ibgraph)
		{
			renderer.setDrawGraph(ibgraph);
		}
		
		public PlotView getPlotView()
		{
			return renderer.getPlotView();
		}
		
		public void generatePlot()
		{
			renderer.generatePlot();
		}
		
		public void animatePlot()
		{
			renderer.animatePlot();
		}
		
		public void onTouchDown(float ix,float iy)
		{
			renderer.onTouchDown(ix, iy);
		}
		
		public void onTouchMove(float ix,float iy)
		{
			renderer.onTouchMove(ix, iy);
		}
		
		public void onTouchUp(float ix,float iy)
		{
			renderer.onTouchUp(ix,iy);
		}
    }
