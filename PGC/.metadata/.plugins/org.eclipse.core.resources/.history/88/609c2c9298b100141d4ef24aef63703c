    public void BtnGraphOnClick(View view)
    {
    	LinearLayout ll = (LinearLayout)findViewById(R.id.mathlayout);
    	ll.setVisibility(View.INVISIBLE);
    	ll = (LinearLayout)findViewById(R.id.graphlayout);
    	ll.setVisibility(View.VISIBLE);
    	
    	if(bdrawgraph==true)
