	@Override
	public void onItemSelected(AdapterView<?> parent, View view, int position,
			long id)
	{
		EqFunction tfunc = (EqFunction)parent.getItemAtPosition(position);
		if(tfunc!=null)
		{
			gfuncs.clearFuncs();
			gfuncs.addFunction(tfunc);
    		fofxadapter.notifyDataSetChanged();
	    	glview.generatePlot();
	    	updateGraphIntervalTable();
	    	glview.requestRender();
		}
	}

