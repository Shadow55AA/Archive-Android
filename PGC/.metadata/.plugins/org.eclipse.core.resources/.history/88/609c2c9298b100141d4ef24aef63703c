    public void BtnRunOnClick(View view)
    {
    	EditText etcmd = (EditText)findViewById(R.id.etcmd);
    	TextView tvres = (TextView)findViewById(R.id.tvres);
    	
    	String cmd = etcmd.getText().toString();
    	
    	calc.RunCommand(cmd);
    	
    	String error = calc.getError();
    	if(error==null)
    		tvres.setText(calc.getOutput());
		else
			tvres.setText(error);
    	if(calc.GetLastCommandType()==EqCalculator.CmdTypeAsgnFunc)
    	{
    		EqFunction tfunc = calc.GetLastFunction();
    		if(tfunc!=null)
    		{
	    		if(tfunc.GetNumVars()==1||tfunc.GetNumVars()==2)
	    		{
	    			gfuncs.clearFuncs();
	    			gfuncs.addFunction(tfunc);
	    		}
	    		fofxadapter.notifyDataSetChanged();
	    		fofxyadapter.notifyDataSetChanged();
	        	glview.generatePlot();
    		}
    	}
    }
    
    public void BtnClearOnClick(View view)
    {
    	EditText etcmd = (EditText)findViewById(R.id.etcmd);
