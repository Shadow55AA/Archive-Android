    			tview = findViewById(R.id.gitvar1t);
    			float txmax = Float.valueOf(((EditText)tview).getText().toString());
    			if(txmax<=txmin)
    			{
    				txmax = txmin+1f;
    				((EditText)tview).setText(""+txmax);
    			}
    			pview.setDomainX(txmin, txmax);
    			glview.generatePlot();
    			float rangey[] = pview.getRangeY();
        		tview = findViewById(R.id.gitvar2f);
        		((EditText)tview).setText(""+rangey[0]);
        		tview = findViewById(R.id.gitvar2t);
        		((EditText)tview).setText(""+rangey[1]);
        	}
    		else if(gfuncs.getGraphMode()==2)
    		{
    			PlotView pview = glview.getPlotView();
    			View tview = findViewById(R.id.gitvar1f);
    			float txmin = Float.valueOf(((EditText)tview).getText().toString());
    			tview = findViewById(R.id.gitvar1t);
    			float txmax = Float.valueOf(((EditText)tview).getText().toString());
    			if(txmax<=txmin)
    			{
    				txmax = txmin+1f;
    				((EditText)tview).setText(""+txmax);
    			}
    			pview.setDomainX(txmin, txmax);
    			tview = findViewById(R.id.gitvar2f);
    			float tymin = Float.valueOf(((EditText)tview).getText().toString());
    			tview = findViewById(R.id.gitvar2t);
    			float tymax = Float.valueOf(((EditText)tview).getText().toString());
    			if(tymax<=tymin)
    			{
    				tymax = tymin+1f;
    				((EditText)tview).setText(""+tymax);
    			}
    			pview.setDomainY(tymin, tymax);
    			glview.generatePlot();
    			float rangey[] = pview.getRangeY();
        		tview = findViewById(R.id.gitvar3f);
        		((TextView)tview).setText(""+rangey[0]);
        		tview = findViewById(R.id.gitvar3t);
        		((TextView)tview).setText(""+rangey[1]);
    		}
    	}
    	else
    	{
    		updateGraphIntervalTable();
    	}
    	
    	bdrawgraph = true;
    	glview.setDrawGraph(true);
    	glview.requestRender();
    }
    
