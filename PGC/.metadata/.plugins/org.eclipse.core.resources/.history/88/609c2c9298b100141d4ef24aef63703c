    }
    
    public void BtnRetOnClick(View view)
    {
    	EditText etcmd = (EditText)findViewById(R.id.etcmd);
    	CharSequence cs = etcmd.getText();
    	if(cs.length()>0)
    	{
	    	etcmd.setText(cs.subSequence(0, cs.length()-1));
	    	etcmd.setSelection(cs.length()-1);
    	}
    }
    
    public void BtnMathOnClick(View view)
    {
