    <application
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme" >
        <activity
            android:name=".SUDD"
            android:label="@string/title_activity_sudd" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CoreActivity"
            android:label="@string/title_activity_core" >
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="SUDD" />
        </activity>
        <activity
            android:name=".CreateNewGame"
            android:label="@string/title_activity_create_new_game" >
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="SUDD" />
        </activity>
        <activity
            android:name=".LoadSavedGame"
            android:label="@string/title_activity_load_saved_game" >
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="SUDD" />
        </activity>
    </application>

</manifest>