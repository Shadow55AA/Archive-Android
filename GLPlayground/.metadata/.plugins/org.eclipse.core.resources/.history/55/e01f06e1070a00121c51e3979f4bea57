package com.lotech.glplayground;

import android.opengl.GLES20;

public class LtGLPlaneShader
{
	private final String vertshadercode =
			"uniform mat4 cproj;" +
			"uniform vec4 cquat" +
			"attribute vec4 vpos;" +
			"vec4 qmul(vec4 q1,vec4 q2)" +
			"{" +
			"	return vec4(q1.w*q2.x+q1.x*q2.w+q1.y*q2.z-q1.z*q2.y," +
			"		q1.w*q2.y+q1.y*q2.w+q1.z*q2.x-q1.x*q2.z," +
			"		q1.w*q2.z+q1.z*q2.w+q1.x*q2.y-q1.y*q2.x," +
			"		q1.w*q2.w-q1.x*q2.x-q1.y*q2.y-q1.z*q2.z);" +
			"};" +
			"vec4 qconj(vec4 q)" +
			"{" +
			"	return vec4(-q.x,-q.y,-q.z,q.w);" +
			"}" +
			"vec4 qrot(vec4 q,vec4 v)" +
			"{" +
			"	return qmul(qmul(q,v),qconj(q));" +
			"}" +
			"void main()" +
			"{" +
			"	vec4 tpos = vpos + vec4(0,0,-2,0);" +
			"	gl_Position = tpos * cproj;" +
			"}";
	
	private final String fragshadercode =
			"precision mediump float;" +
			"uniform vec4 vcolor;" +
			"void main()" +
			"{" +
			"	gl_FragColor = vcolor;" +
			"}";
	
	private int program;
	
	LtGLPlaneShader()
	{
		int vertshader = LoadShader(GLES20.GL_VERTEX_SHADER, vertshadercode);
		int fragshader = LoadShader(GLES20.GL_FRAGMENT_SHADER, fragshadercode);
		
		program = GLES20.glCreateProgram();
		GLES20.glAttachShader(program, vertshader);
		GLES20.glAttachShader(program, fragshader);
		GLES20.glLinkProgram(program);
	}
	
	public static int LoadShader(int stype, String scode)
	{
		int shader = GLES20.glCreateShader(stype);
		
		GLES20.glShaderSource(shader, scode);
		GLES20.glCompileShader(shader);
		
		return shader;
	}
	
	public void UseShader()
	{
		GLES20.glUseProgram(program);
	}
	
	public int GetProgram()
	{
		return program;
	}
}
