package com.lotech.glplayground;

import java.nio.ByteBuffer;
import java.nio.ByteOrder;
import java.nio.FloatBuffer;

import android.opengl.GLES20;

public class LtGLPen
{
	FloatBuffer planevertbuff;
	FloatBuffer planenormbuff;
	LtGLPlaneShader planeshader;
	
	static float planeverts [] = 
	{
		-0.5f,-0.5f,0f,
		0.5f,0f,0f,
		0f,0.5f,0f
	};
	
	static float planenorms [] =
	{
		0,0,1f,
		0,0,1f,
		0,0,1f
	};
	
	LtGLPen()
	{
		ByteBuffer pvbb = ByteBuffer.allocateDirect(planeverts.length*4);
		pvbb.order(ByteOrder.nativeOrder());
		planevertbuff = pvbb.asFloatBuffer();
		planevertbuff.put(planeverts);
		planevertbuff.position(0);
		ByteBuffer pnbb = ByteBuffer.allocateDirect(planenorms.length*4);
		pnbb.order(ByteOrder.nativeOrder());
		planenormbuff = pnbb.asFloatBuffer();
		planenormbuff.put(planenorms);
		planenormbuff.position(0);
		
		planeshader = new LtGLPlaneShader();
	}
	
	public void DrawPlane()
	{
		planeshader.UseShader();
		int shader = planeshader.GetProgram();
		int scolor = GLES20.glGetUniformLocation(shader, "vcolor");
		float color[] = {1,0,0,1};
		GLES20.glUniform4fv(scolor, 1, color,0);
		
		int svpos = GLES20.glGetAttribLocation(shader, "vpos");
		
		GLES20.glEnableVertexAttribArray(svpos);
		GLES20.glVertexAttribPointer(svpos,3,GLES20.GL_FLOAT,false,12,planevertbuff);
		
		GLES20.glDrawArrays(GLES20.GL_TRIANGLES, 0, 3);
		GLES20.glDisableVertexAttribArray(svpos);
		
	}
}
